<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wm="using:SubZeroDev.WindowManager.Host.Surfaces.Controls">

    <!-- Host defaults: used when no theme loads. Literal colours are allowed here only. -->

    <Style TargetType="wm:WmPanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmPanel">
                    <Border Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="0,1,0,0">
                        <Grid Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Start}" />
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Center}" />
                            <ContentPresenter Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{TemplateBinding End}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmZone">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmContribution">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmContribution">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmPlaceholder">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmPlaceholder">
                    <Border x:Name="Root" Padding="6,2" CornerRadius="4" Background="#FF2B2B2B">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ReasonStates">
                                <VisualState x:Name="Missing" />
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Starting" />
                                <VisualState x:Name="Unavailable" />
                                <VisualState x:Name="NotSupportedInMode" />
                                <VisualState x:Name="Invalid" />
                                <VisualState x:Name="Incompatible">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A4A00" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Faulted">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A1010" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock Foreground="#FFB0B0B0" FontSize="12" Text="{TemplateBinding PluginName}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
