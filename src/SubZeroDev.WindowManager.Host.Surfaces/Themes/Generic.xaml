<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wm="using:SubZeroDev.WindowManager.Host.Surfaces.Controls">

    <!-- Host defaults: used when no theme loads. Literal colours are allowed here only. -->

    <Style TargetType="wm:WmPanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmPanel">
                    <Border Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="0,1,0,0">
                        <Grid Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Start}" />
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Center}" />
                            <ContentPresenter Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{TemplateBinding End}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmZone">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <wm:WmFitPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmContribution">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmContribution">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmPlaceholder">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmPlaceholder">
                    <Border x:Name="Root" Padding="6,2" CornerRadius="4" Background="#FF2B2B2B">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ReasonStates">
                                <VisualState x:Name="Missing" />
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Starting" />
                                <VisualState x:Name="Unavailable">
                                    <VisualState.Setters>
                                        <Setter Target="Retry.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NotSupportedInMode" />
                                <VisualState x:Name="Invalid" />
                                <VisualState x:Name="Incompatible">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A4A00" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Faulted">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A1010" />
                                        <Setter Target="Retry.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Foreground="#FFB0B0B0" FontSize="12" VerticalAlignment="Center" Text="{TemplateBinding PluginName}" />
                            <Button x:Name="Retry" Visibility="Collapsed" Padding="6,0" MinHeight="0" FontSize="11" Content="Retry"
                                    Command="{TemplateBinding RetryCommand}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmText">
        <Setter Property="Foreground" Value="#FFE6E6E6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmText">
                    <TextBlock x:Name="Text" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                               Text="{TemplateBinding Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmIcon">
                    <Image Source="{TemplateBinding Icon}" Stretch="Uniform" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmList">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmList">
                    <wm:WmFitPanel x:Name="PART_Items" Spacing="2" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmStack">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmStack">
                    <StackPanel x:Name="PART_Items" Spacing="4" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmSpacer">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmSpacer">
                    <Border />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmSeparator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmSeparator">
                    <Rectangle Width="1" MinHeight="16" Margin="4,0" Fill="#FF3A3A3A" VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmButton">
        <Setter Property="Foreground" Value="#FFE6E6E6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmButton">
                    <Grid x:Name="Root" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF2E2E2E" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF3A3A3A" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualState x:Name="Inactive" />
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="AttentionStates">
                                <VisualState x:Name="Calm" />
                                <VisualState x:Name="Attention">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A4A00" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Selection.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Selection" Visibility="Collapsed" Margin="-8,-2" CornerRadius="4" Background="#FF26405A" />
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{TemplateBinding Icon}" MaxHeight="16" MaxWidth="16" Stretch="Uniform" />
                            <TextBlock x:Name="Label" Grid.Column="1" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="{TemplateBinding Label}" />
                            <TextBlock x:Name="Badge" Grid.Column="2" Foreground="#FFE6E6E6" FontSize="10" VerticalAlignment="Top" Text="{TemplateBinding Badge}" />
                        </Grid>
                        <Rectangle x:Name="Indicator" Visibility="Collapsed" Height="2" VerticalAlignment="Bottom" Fill="#FF6CB8F6" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmToggle">
        <Setter Property="Foreground" Value="#FFE6E6E6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmToggle">
                    <Grid x:Name="Root" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF2E2E2E" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF3A3A3A" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualState x:Name="Inactive" />
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="AttentionStates">
                                <VisualState x:Name="Calm" />
                                <VisualState x:Name="Attention">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF5A4A00" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="{TemplateBinding Icon}" MaxHeight="16" MaxWidth="16" Stretch="Uniform" />
                            <TextBlock x:Name="Label" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center" Text="{TemplateBinding Label}" />
                        </StackPanel>
                        <Rectangle x:Name="Indicator" Visibility="Collapsed" Height="2" VerticalAlignment="Bottom" Fill="#FF6CB8F6" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmPopup">
        <Setter Property="Foreground" Value="#FFE6E6E6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmPopup">
                    <Border x:Name="Root" Padding="8" CornerRadius="8" Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OpenStates">
                                <VisualState x:Name="Opening" />
                                <VisualState x:Name="Open" />
                                <VisualState x:Name="Closing" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="wm:WmNotice">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wm:WmNotice">
                    <Border Padding="8,4" CornerRadius="4" Background="#FF5A1010" BorderBrush="#FF3A3A3A" BorderThickness="1">
                        <TextBlock x:Name="Message" Foreground="#FFE6E6E6" FontSize="12" TextWrapping="Wrap" MaxWidth="320"
                                   Text="{TemplateBinding Message}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
