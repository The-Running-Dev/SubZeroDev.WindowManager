<Project Sdk="Microsoft.NET.Sdk">
  <!-- Keeps the Windows target framework (unlike the other plugins): the notification listener is a WinRT API. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SubZeroDev.WindowManager.Plugins.Notifications</RootNamespace>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Sdk\SubZeroDev.WindowManager.Sdk.csproj" />
    <!-- The Sdk keeps Protocol private (it ships inside the Sdk package), so a source build names it too. -->
    <ProjectReference Include="..\SubZeroDev.WindowManager.Protocol\SubZeroDev.WindowManager.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sparse package that gives this executable package identity; register.ps1 installs it. -->
    <None Include="package\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="package" />
  </ItemGroup>
</Project>
