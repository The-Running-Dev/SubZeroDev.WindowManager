<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plugin authors run it beside their own build, so it needs no Windows target framework. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion></TargetPlatformMinVersion>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RootNamespace>SubZeroDev.WindowManager.PackTool</RootNamespace>
    <AssemblyName>wm-pack</AssemblyName>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Protocol\SubZeroDev.WindowManager.Protocol.csproj" />
  </ItemGroup>
</Project>
