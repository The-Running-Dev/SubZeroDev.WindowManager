<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plugin authors run it beside their own build, so it needs no Windows target framework. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion></TargetPlatformMinVersion>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RuntimeIdentifier></RuntimeIdentifier>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>SubZeroDev.WindowManager.PackTool</RootNamespace>
    <AssemblyName>wm-pack</AssemblyName>
    <SelfContained>false</SelfContained>
    <!-- Shipped as a .NET tool: `dotnet tool install SubZeroDev.WindowManager.PackTool` gives `wm-pack`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wm-pack</ToolCommandName>
    <PackageId>SubZeroDev.WindowManager.PackTool</PackageId>
    <Authors>SubZeroDev</Authors>
    <Description>Packages a SubZeroDev.WindowManager plugin build output into an installable zip.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Protocol\SubZeroDev.WindowManager.Protocol.csproj" />
  </ItemGroup>
</Project>
