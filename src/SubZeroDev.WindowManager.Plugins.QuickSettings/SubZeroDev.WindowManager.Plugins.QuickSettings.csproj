<Project Sdk="Microsoft.NET.Sdk">
  <!-- Keeps the Windows target framework (unlike most plugins): the radios are a WinRT API. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SubZeroDev.WindowManager.Plugins.QuickSettings</RootNamespace>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Sdk\SubZeroDev.WindowManager.Sdk.csproj" />
    <!-- The Sdk keeps Protocol private (it ships inside the Sdk package), so a source build names it too. -->
    <ProjectReference Include="..\SubZeroDev.WindowManager.Protocol\SubZeroDev.WindowManager.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
