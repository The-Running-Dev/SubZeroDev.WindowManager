<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SubZeroDev.WindowManager.Host</AssemblyName>
    <RootNamespace>SubZeroDev.WindowManager.Host.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Core\SubZeroDev.WindowManager.Host.Core.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Platform\SubZeroDev.WindowManager.Host.Platform.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Theming\SubZeroDev.WindowManager.Host.Theming.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Surfaces\SubZeroDev.WindowManager.Host.Surfaces.csproj" />
    <!-- Built first so its output can ship as a built-in plugin; the host never loads it. -->
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.Clock\SubZeroDev.WindowManager.Plugins.Clock.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.RunningWindows\SubZeroDev.WindowManager.Plugins.RunningWindows.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in themes, layouts and presets ship beside the host. -->
    <Content Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Built-in plugins run as workers from <content>\plugins\<id>. -->
  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <ItemGroup>
      <ClockFiles Include="..\SubZeroDev.WindowManager.Plugins.Clock\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
      <RunningWindowsFiles Include="..\SubZeroDev.WindowManager.Plugins.RunningWindows\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClockFiles)" DestinationFiles="@(ClockFiles->'$(OutDir)content\plugins\subzerodev.clock\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RunningWindowsFiles)" DestinationFiles="@(RunningWindowsFiles->'$(OutDir)content\plugins\subzerodev.running-windows\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
