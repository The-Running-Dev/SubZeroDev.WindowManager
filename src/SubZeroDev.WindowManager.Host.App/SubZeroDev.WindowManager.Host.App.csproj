<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SubZeroDev.WindowManager.Host</AssemblyName>
    <RootNamespace>SubZeroDev.WindowManager.Host.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it, publish leaves out the .pri and compiled XAML that the settings window loads. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Core\SubZeroDev.WindowManager.Host.Core.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Platform\SubZeroDev.WindowManager.Host.Platform.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Theming\SubZeroDev.WindowManager.Host.Theming.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Surfaces\SubZeroDev.WindowManager.Host.Surfaces.csproj" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Host.Settings\SubZeroDev.WindowManager.Host.Settings.csproj" />
    <!-- Built first so its output can ship as a built-in plugin; the host never loads it. Private="false" keeps
         each plugin's plugin.json out of the host's own output and publish folders. -->
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.Clock\SubZeroDev.WindowManager.Plugins.Clock.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.RunningWindows\SubZeroDev.WindowManager.Plugins.RunningWindows.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.Launcher\SubZeroDev.WindowManager.Plugins.Launcher.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.Plugins.Tray\SubZeroDev.WindowManager.Plugins.Tray.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in themes, layouts and presets ship beside the host. They are None, not Content, so the
         PRI indexer does not read folder names such as "sample-retro" as resource qualifiers. -->
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Built-in plugins run as workers from <content>\plugins\<id>. -->
  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <ItemGroup>
      <ClockFiles Include="..\SubZeroDev.WindowManager.Plugins.Clock\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
      <RunningWindowsFiles Include="..\SubZeroDev.WindowManager.Plugins.RunningWindows\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
      <LauncherFiles Include="..\SubZeroDev.WindowManager.Plugins.Launcher\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
      <TrayFiles Include="..\SubZeroDev.WindowManager.Plugins.Tray\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClockFiles)" DestinationFiles="@(ClockFiles->'$(OutDir)content\plugins\subzerodev.clock\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RunningWindowsFiles)" DestinationFiles="@(RunningWindowsFiles->'$(OutDir)content\plugins\subzerodev.running-windows\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LauncherFiles)" DestinationFiles="@(LauncherFiles->'$(OutDir)content\plugins\subzerodev.launcher\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TrayFiles)" DestinationFiles="@(TrayFiles->'$(OutDir)content\plugins\subzerodev.tray\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
