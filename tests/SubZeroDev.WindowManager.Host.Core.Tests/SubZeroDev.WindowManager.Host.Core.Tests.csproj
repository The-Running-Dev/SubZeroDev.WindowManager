<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SubZeroDev.WindowManager.Host.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Host.Core\SubZeroDev.WindowManager.Host.Core.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Host.Theming\SubZeroDev.WindowManager.Host.Theming.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Host.Platform\SubZeroDev.WindowManager.Host.Platform.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.PackTool\SubZeroDev.WindowManager.PackTool.csproj" />
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Sdk\SubZeroDev.WindowManager.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Thumbnail and hoverPopup decisions carry no WinUI, so they are tested without the Surfaces project. -->
    <Compile Include="..\..\src\SubZeroDev.WindowManager.Host.Surfaces\ThumbnailLogic.cs" Link="Surfaces\ThumbnailLogic.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
