<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SubZeroDev.WindowManager.EndToEnd.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UI Automation (System.Windows.Automation) checks the settings window's accessible names. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <!-- UseWPF swaps the implicit usings for WPF ones, which leave out System.IO. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built first so the executables exist; nothing is referenced at compile time. -->
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Host.App\SubZeroDev.WindowManager.Host.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\SubZeroDev.WindowManager.Guardian\SubZeroDev.WindowManager.Guardian.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SubZeroDev.WindowManager.TestPlugin\SubZeroDev.WindowManager.TestPlugin.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HostExe" Value="$(MSBuildThisFileDirectory)..\..\src\SubZeroDev.WindowManager.Host.App\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\SubZeroDev.WindowManager.Host.exe" />
    <AssemblyMetadata Include="GuardianExe" Value="$(MSBuildThisFileDirectory)..\..\src\SubZeroDev.WindowManager.Guardian\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\SubZeroDev.WindowManager.exe" />
    <AssemblyMetadata Include="TestPluginDir" Value="$(MSBuildThisFileDirectory)..\SubZeroDev.WindowManager.TestPlugin\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)" />
  </ItemGroup>
</Project>
