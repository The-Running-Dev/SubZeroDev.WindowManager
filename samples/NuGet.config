<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Its own cache, so a package from an earlier release never stands in for the one under test. -->
    <add key="globalPackagesFolder" value="../artifacts/samples-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="release" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="release">
      <package pattern="SubZeroDev.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
