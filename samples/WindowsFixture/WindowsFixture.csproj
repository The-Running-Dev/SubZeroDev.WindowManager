<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Example.Windows</RootNamespace>
    <AssemblyName>Example.Windows</AssemblyName>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the released package, never a project reference into the app's sources (I2). -->
    <PackageReference Include="SubZeroDev.WindowManager.Sdk" Version="*-*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
